@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.org/irish-tourism/> .

ex:FoodSpotShape
    a sh:NodeShape ;
    sh:targetClass ex:FoodSpot ;

    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each FoodSpot must have exactly one string name." ;
    ] ;

    sh:property [
        sh:path ex:locatedInCounty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://example.org/irish-tourism/county/" ;
        sh:message "Each FoodSpot must link to exactly one valid County IRI." ;
    ] ;

    sh:property [
        sh:path ex:hasVenueType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://example.org/irish-tourism/venue-type/" ;
        sh:message "Each FoodSpot must link to exactly one VenueType IRI." ;
    ] ;

    sh:property [
        sh:path schema:latitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 51.0 ;
        sh:maxInclusive 56.0 ;
        sh:message "FoodSpot latitude must be a decimal between 51.0 and 56.0." ;
    ] ;

    sh:property [
        sh:path schema:longitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -11.0 ;
        sh:maxInclusive -5.0 ;
        sh:message "FoodSpot longitude must be a decimal between -11.0 and -5.0." ;
    ] .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.org/irish-tourism/> .

#MAP 1: Accom mapping
<AccommodationMapping> 
    a rr:TriplesMap ;  

rml:logicalSource [
    rml:source "Accommodation_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
    ] ;


rr:subjectMap [
    rr:template "https://example.org/irish-tourism/accommodation/{Property Reg Number}" ;
    rr:class ex:Accommodation 
    ] ; 

#name
rr:predicateObjectMap [
    rr:predicate ex:name ;
    rr:objectMap [
        rml:reference "Account Name"
    ]
] ; 

#link accom w county individual
rr:predicateObjectMap [
    rr:predicate ex:locatedInCounty ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/county/{Address County}"
    ]
] ; 

#hasAccommodationType
rr:predicateObjectMap [
    rr:predicate ex:hasAccommodationType ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/accommodation-type/{Sector}"
    ]
] ;

#address
rr:predicateObjectMap [
    rr:predicate ex:address ;
    rr:objectMap [
        rml:reference "Address Line 1"
    ]
] ; 

#link accom to town individual
rr:predicateObjectMap [
    rr:predicate ex:locatedInTown ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/town/{Address County}/{Address City/Town}" ;
    ]
] ; 

#orginal rating desc
rr:predicateObjectMap [
    rr:predicate ex:ratingDescription ;
    rr:objectMap [
        rml:reference "Rating"
    ]
] ; 

#numeric star rating
rr:predicateObjectMap [
    rr:predicate ex:starRating ;
    rr:objectMap [
        rml:reference "Star Rating" ;
        rr:datatype xsd:integer
    ]
] ; 

#latitude
rr:predicateObjectMap [
    rr:predicate schema:latitude ;
    rr:objectMap [
        rml:reference "Latitude" ;
        rr:datatype xsd:decimal
    ]
] ; 

#longitude
rr:predicateObjectMap [
    rr:predicate schema:longitude ;
    rr:objectMap [
        rml:reference "Longitude" ;
        rr:datatype xsd:decimal
    ]
] .

#MAP 2: County mapping
<CountyMapping> 
    a rr:TriplesMap ;

rml:logicalSource [
    rml:source "Accommodation_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/county/{Address County}" ;
    rr:class ex:County 
    ] ; 

rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "Address County"
    ]
] ;

#connect each county w Ireland
rr:predicateObjectMap [
    rr:predicate ex:partOf ;
    rr:objectMap [
        rr:constant ex:Ireland
    ]
] .

#MAP 3: Accom type mapping
<AccommodationTypeMapping> 
    a rr:TriplesMap ;

rml:logicalSource [
    rml:source "Accommodation_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/accommodation-type/{Sector}" ;
    rr:class ex:AccommodationType 
    ] ; 

rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "Sector"
    ]
] .

#MAP 4: Town mapping
<TownMapping>
    a rr:TriplesMap ;

rml:logicalSource [
    rml:source "Accommodation_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/town/{Address County}/{Address City/Town}" ;
    rr:class ex:Town 
    ] ; 

rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "Address City/Town"
    ]
] ;

#connect each town w county
rr:predicateObjectMap [
    rr:predicate ex:townInCounty ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/county/{Address County}" ;
    ]
] .
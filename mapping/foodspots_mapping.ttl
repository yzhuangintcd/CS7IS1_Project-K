@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.org/irish-tourism/> .


# ==============================================================================
# OVERVIEW: Irish Tourism Food Spots RML Mapping
# ==============================================================================
# Source File : FoodSpots_cleaned.csv
# Target Graph: Irish Tourism Knowledge Graph (https://example.org/irish-tourism/)
#
# Purpose:
#   Uplifts tabular CSV rows of Irish food spots into interconnected RDF triples.
#   Each CSV row is decomposed into three semantic entities:
#     1. ex:Foodspot  - The restaurant/cafe with its name and coordinates.
#     2. ex:County    - The Irish county where it is located (linked to Ireland).
#     3. ex:VenueType - The category of the venue (e.g., Cafe, Pub, Restaurant).
#
# High-Level Graph Structure:
#   [ex:Foodspot] --(ex:locatedInCounty)--> [ex:County] --(ex:partOf)--> [ex:Ireland]
#         |
#         +---------(ex:hasVenueType)-----> [ex:VenueType]
# ==============================================================================

# ==============================================================================
# MAP 1: FoodSpot Mapping
# ==============================================================================
# Generates the core FoodSpot entity for each row using its unique FoodSpot_ID
# and attaches its literal attributes and links to County and VenueType nodes.
#
# Illustration (Generated Triples per Row):
#                        +--- rdf:type -----------> ex:Foodspot
#                        +--- ex:name ------------> "Name"
#   <foodspots/{ID}> ----+--- ex:locatedInCounty -> <county/{County}>
#                        +--- schema:latitude ----> "Latitude"^^xsd:decimal
#                        +--- schema:longitude ---> "Longitude"^^xsd:decimal
#                        +--- ex:hasVenueType ----> <venue-type/{Venue Type}>
# ==============================================================================
<FoodspotMapping> a rr:TriplesMap ;
rml:logicalSource [
    rml:source "FoodSpots_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ;

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/foodspots/{FoodSpot_ID}" ;
    rr:class ex:Foodspot
] ;

# Name of the food spot
rr:predicateObjectMap [
    rr:predicate ex:name ;
    rr:objectMap [ 
        rml:reference "Name"
    ]
] ;

# Link to the County entity
rr:predicateObjectMap [
    rr:predicate ex:locatedInCounty ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/county/{County}"
    ]
] ; 

#latitude
rr:predicateObjectMap [
    rr:predicate schema:latitude ;
    rr:objectMap [
        rml:reference "Latitude" ;
        rr:datatype xsd:decimal
    ]
] ; 

#longitude
rr:predicateObjectMap [
    rr:predicate schema:longitude ;
    rr:objectMap [
        rml:reference "Longitude" ;
        rr:datatype xsd:decimal
    ]
] ;

# Link to the VenueType entity
rr:predicateObjectMap [
    rr:predicate ex:hasVenueType ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/venue-type/{Venue Type}"
    ]
] .


# ==============================================================================
# MAP 2: County Mapping
# ==============================================================================
# Creates a shared County node for each unique county name and anchors it to
# the top-level ex:Ireland entity so all datasets share common county hubs.
#
# Illustration (Generated Triples per County):
#                        +--- rdf:type ---> ex:County
#   <county/{County}> ---+--- rdfs:label -> "County"
#                        +--- ex:partOf --> ex:Ireland
# ==============================================================================
<CountyMapping> a rr:TriplesMap ;

rml:logicalSource [
    rml:source "FoodSpots_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/county/{County}" ;
    rr:class ex:County 
    ] ; 

# County label
rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "County"
    ]
] ;

# Link connecting every county to Ireland
rr:predicateObjectMap [
    rr:predicate ex:partOf ;
    rr:objectMap [
        rr:constant ex:Ireland
    ]
] .

# ==============================================================================
# MAP 3: Venue Type Mapping
# ==============================================================================
# Creates a reusable VenueType category node for each unique venue classification
# (e.g., Restaurant, Cafe, Pub) and attaches a human-readable label.
#
# Illustration (Generated Triples per Venue Type):
#                                  +--- rdf:type ---> ex:VenueType
#   <venue-type/{Venue Type}> -----+--- rdfs:label -> "Venue Type"
# ==============================================================================
<VenueTypeMapping> a rr:TriplesMap ;

rml:logicalSource [
    rml:source "FoodSpots_cleaned.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/venue-type/{Venue Type}" ;
    rr:class ex:VenueType 
] ; 

# Venue category label
rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "Venue Type"
    ]
] .



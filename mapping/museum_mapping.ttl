@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.org/irish-tourism/> .

# ==============================================================================
# OVERVIEW: Irish Tourism Museums RML Mapping
# ==============================================================================
# Source File : Cleaned_Museums.csv
# Target Graph: Irish Tourism Knowledge Graph (https://example.org/irish-tourism/)
#
# Purpose:
#   Uplifts tabular CSV rows describing Irish museums and heritage centres into
#   interconnected RDF triples. Each CSV row is decomposed into two semantic
#   entities:
#     1. ex:Museum - The cultural attraction with its name and coordinates.
#     2. ex:County - The Irish county where it is located (linked to Ireland).
#
# High-Level Graph Structure:
#   [ex:Museum] --(ex:locatedInCounty)--> [ex:County] --(ex:partOf)--> [ex:Ireland]
# ==============================================================================

# ==============================================================================
# MAP 1: Museum Mapping
# ==============================================================================
# Generates the core Museum entity for each row using its unique OBJECT_ID and
# attaches its name, coordinates, and link to the corresponding County entity.
#
# Illustration (Generated Triples per Row):
#                        +--- rdf:type -----------> ex:Museum
#                        +--- ex:name ------------> "Name of Museum or HC"
#   <museum/{OBJECT_ID}> -+--- ex:locatedInCounty -> <county/{County}>
#                        +--- schema:latitude ----> "LATITUDE"^^xsd:decimal
#                        +--- schema:longitude ---> "LONGITUDE"^^xsd:decimal
# ==============================================================================
<MuseumMapping> a rr:TriplesMap ;

rml:logicalSource [
    rml:source "Cleaned_Museums.csv" ;
    rml:referenceFormulation ql:CSV
] ;

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/museum/{OBJECT_ID}" ;
    rr:class ex:Museum
] ;

# Name of the museum or heritage centre
rr:predicateObjectMap [
    rr:predicate ex:name ;
    rr:objectMap [ 
        rml:reference "Name of Museum or HC"
    ]
] ;

# Link to the County entity
rr:predicateObjectMap [
    rr:predicate ex:locatedInCounty ;
    rr:objectMap [
        rr:template "https://example.org/irish-tourism/county/{County}"
    ]
] ; 

#latitude
rr:predicateObjectMap [
    rr:predicate schema:latitude ;
    rr:objectMap [
        rml:reference "LATITUDE" ;
        rr:datatype xsd:decimal
    ]
] ; 

#longitude
rr:predicateObjectMap [
    rr:predicate schema:longitude ;
    rr:objectMap [
        rml:reference "LONGITUDE" ;
        rr:datatype xsd:decimal
    ]
] .

# ==============================================================================
# MAP 2: County Mapping
# ==============================================================================
# Creates a shared County node for each unique county name and anchors it to
# the top-level ex:Ireland entity so all datasets share common county hubs.
#
# Illustration (Generated Triples per County):
#                        +--- rdf:type ---> ex:County
#   <county/{County}> ---+--- rdfs:label -> "County"
#                        +--- ex:partOf --> ex:Ireland
# ==============================================================================
<CountyMapping> 
    a rr:TriplesMap ;

rml:logicalSource [
    rml:source "Cleaned_Museums.csv" ;
    rml:referenceFormulation ql:CSV
] ; 

rr:subjectMap [
    rr:template "https://example.org/irish-tourism/county/{County}" ;
    rr:class ex:County 
    ] ; 

rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "County"
    ]
] ;

# Link connecting every county to Ireland
rr:predicateObjectMap [
    rr:predicate ex:partOf ;
    rr:objectMap [
        rr:constant ex:Ireland
    ]
] .